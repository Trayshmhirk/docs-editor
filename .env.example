# ==============================================================================
# Docs Editor Environment Variables
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# Clerk Authentication (https://clerk.com)
NODE_ENV=development
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional: Disable Clerk telemetry pings during development
NEXT_PUBLIC_CLERK_TELEMETRY_DISABLED=1

# Liveblocks Real-Time Collaboration (https://liveblocks.io)
LIVEBLOCKS_SECRET_KEY=sk_dev_your_liveblocks_secret_key

# Sentry Monitoring (https://sentry.io - Optional for local dev)
SENTRY_AUTH_TOKEN=your_sentry_auth_token
